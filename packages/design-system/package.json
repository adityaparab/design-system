{
  "name": "@verity/design-system",
  "version": "1.0.0",
  "description": "Verity design system: an owned React API over PrimeReact (unstyled + pass-through), themed by multi-tenant design tokens.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.json": "./dist/tokens.json",
    "./manifest.json": "./dist/manifest.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-tokens.ts",
    "build:manifest": "node scripts/build-manifest.ts",
    "build": "pnpm build:tokens && vite build && tsc -p tsconfig.build.json && pnpm build:manifest",
    "dev": "vite build --watch",
    "test": "pnpm build:tokens && vitest run",
    "lint": "eslint .",
    "typecheck": "pnpm build:tokens && tsc --noEmit",
    "storybook": "pnpm build:tokens && storybook dev -p 6006 --no-open",
    "build-storybook": "pnpm build:tokens && storybook build"
  },
  "dependencies": {
    "primereact": "10.9.9"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
