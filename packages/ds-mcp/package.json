{
  "name": "@verity/ds-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that gives coding agents (Claude Code, Cursor) the Verity design system: components, props, tokens, rules, and a snippet reviewer.",
  "bin": {
    "verity-ds-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@verity/design-system": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
